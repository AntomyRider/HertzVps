// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String    @id @default(cuid())
  discordId String    @unique
  name      String
  avatar    String?
  role      Role      @default(USER)
  balance   Decimal   @default(0.00) @db.Decimal(10,2)
  orders    Order[]
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([discordId])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  image     String?
  products  Product[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([name])
}

model Product {
  id           String    @id @default(cuid())
  categoryId   String

  name         String
  price        Decimal   @db.Decimal(10, 2)
  stock        String    @db.Text
  image        String?
  description  String?   @db.Text
  soldCount    Int       @default(0)
  totalRevenue Decimal   @default(0.00) @db.Decimal(10, 2)

  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orders       Order[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([categoryId])
}

model Order {
  id             String   @id @default(cuid())
  userId         String
  productId      String?
  productName    String
  productImage   String?
  price          Decimal  @db.Decimal(10, 2)
  quantity       Int      @default(1)
  deliveredStock String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
}

enum PaymentMethod {
  TRUEMONEY
  BANKING
}

enum PaymentStatus {
  PENDING
  SUCCESS
  REJECTED
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod @default(TRUEMONEY)
  status      PaymentStatus @default(SUCCESS)
  voucherCode String?
  senderName  String?
  note        String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model PaymentSetting {
  id                String   @id @default(cuid())
  truemoneyPhone    String?
  truemoneyEnabled  Boolean  @default(true)
  bankEnabled       Boolean  @default(false)
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Key {
  id          String    @id @default(cuid())
  code        String    @unique
  isActive     Boolean   @default(true)
  durationDays Int       @default(30)
  hwid         String?
  activatedAt DateTime?
  hwidResetAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

model ProgramDailyStat {
  id           String   @id @default(cuid())
  date         DateTime @unique @db.Date
  total        Int      @default(0)
  success      Int      @default(0)
  failed       Int      @default(0)
  pending      Int      @default(0)
  postCount    Int      @default(0)
  commentCount Int      @default(0)
  reactCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
}