# ==============================================================================
# Hertz Server — Production .gitignore
# ==============================================================================

# 1. Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Next.js & Build Outputs
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts

# 3. Prisma Generated & Local DB Files
/app/generated/prisma
/prisma/*.db
/prisma/*.db-journal
/prisma/*.sqlite
/prisma/*.sqlite-journal

# 4. Environment Variables & Secrets (Keep .env.example in git)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# 5. Docker Local Data Volumes
/docker-data/
/mariadb-data/
/mysql-data/

# 6. Logs & Crash Reports
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 7. Testing & Coverage
/coverage/
/.nyc_output/

# 8. OS, IDE & Deployment Tooling
.DS_Store
Thumbs.db
Desktop.ini
.vercel
.idea/
.vscode/*
!.vscode/extensions.json
.agents/
.claude/
.windsurf/
