# ==============================================================================
# Hertz Server — .dockerignore
# ==============================================================================

# Dependencies & Build Artifacts (rebuilt inside container)
node_modules
.next
out
build
dist
coverage
*.tsbuildinfo

# Version Control & Docs
.git
.gitignore
README.md
AGENTS.md
CLAUDE.md
skills-lock.json

# Local Secrets & Environment (injected at runtime via docker-compose / env)
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Local Volumes & Logs
docker-data
mariadb-data
mysql-data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Agent Folders
.DS_Store
Thumbs.db
.vscode
.idea
.vercel
.agents
.claude
.windsurf
