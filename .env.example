# ==============================================================================
# Hertz Server — Environment Variables Template (.env.example)
# Copy this file to `.env` and fill in your actual production credentials.
# ==============================================================================

# --- Application Settings ---
NODE_ENV=production
APP_PORT=3000

# --- MariaDB / MySQL Database ---
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_USER=hertz_user
DATABASE_PASSWORD=change_this_db_password
DATABASE_NAME=hertz_db
MARIADB_ROOT_PASSWORD=change_this_root_password

# Prisma CLI Connection URL (must match credentials above)
DATABASE_URL="mysql://hertz_user:change_this_db_password@db:3306/hertz_db"

# Automatically run Prisma migrations & seed admin user on container startup
RUN_MIGRATIONS=true
RUN_SEED=true

# --- Initial Admin Account (Discord ID) ---
ADMIN_DISCORD_ID=1048215319409328189
ADMIN_NAME=nutx

# --- Authentication & JWT ---
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_32_chars

# --- Discord OAuth2 ---
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://hertzx.xyz/api/v1/auth/discord/callback
